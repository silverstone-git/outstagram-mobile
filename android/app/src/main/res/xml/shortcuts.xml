<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press launcher shortcuts. Data URIs become go_router routes (Flutter deep linking). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="new_post" android:enabled="true" android:icon="@drawable/ic_shortcut_post"
        android:shortcutShortLabel="@string/shortcut_new_post_short" android:shortcutLongLabel="@string/shortcut_new_post_long">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="@string/application_id"
            android:targetClass="com.cyto.outstagram.MainActivity"
            android:data="outstagram://app/create"/>
    </shortcut>
    <shortcut android:shortcutId="practice" android:enabled="true" android:icon="@drawable/ic_shortcut_exam"
        android:shortcutShortLabel="@string/shortcut_practice_short" android:shortcutLongLabel="@string/shortcut_practice_long">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="@string/application_id"
            android:targetClass="com.cyto.outstagram.MainActivity"
            android:data="outstagram://app/exams"/>
    </shortcut>
    <shortcut android:shortcutId="tutor" android:enabled="true" android:icon="@drawable/ic_shortcut_tutor"
        android:shortcutShortLabel="@string/shortcut_tutor_short" android:shortcutLongLabel="@string/shortcut_tutor_long">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="@string/application_id"
            android:targetClass="com.cyto.outstagram.MainActivity"
            android:data="outstagram://app/tutor"/>
    </shortcut>
</shortcuts>
