<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen streak widget (StreakWidgetProvider.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/streak_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/streak_flame"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame" />

        <TextView
            android:id="@+id/streak_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="day streak"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/streak_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Start a streak today"
        android:textColor="#FFFFB648"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
